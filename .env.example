# Daily Reflection MCP server — copy to .env (never commit .env)
PORT=3939
DR_DB_PATH=./data/reflection.sqlite
# On a FUSE mount (Cloud Run GCS volume) WAL is unsafe → DR_SQLITE_JOURNAL=DELETE (default WAL)
# DR_SQLITE_JOURNAL=DELETE
# Optional saju lens (tool 2). Leave unset → get_daily_lens answers lens_unavailable; other tools work.
SAJU_LENS_URL=https://<saju-backend>/api/reflection/lens
REFLECTION_SERVICE_KEY=<shared secret, same value on the saju backend>
# Recommended on any public deployment: clients must send header `X-DR-Token: <token>` to /mcp and /profiles (Cloud Run intercepts `Authorization: Bearer`).
DR_ACCESS_TOKEN=<random string>
# Web simulation (GET /sim): the host model behind the voice. Without a key the page loads but /sim/chat answers 503.
# Nebius Token Factory (NVIDIA Nemotron, the hackathon configuration):
SIM_API_KEY=<nebius token factory key>
SIM_API_BASE=https://api.tokenfactory.nebius.com/v1
SIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# OpenRouter (the original free-tier configuration) instead:
# OPENROUTER_API_KEY=<openrouter key>      # accepted as a fallback for SIM_API_KEY
# SIM_API_BASE=https://openrouter.ai/api/v1
# SIM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SIM_REASONING=on   # default off. Off = `reasoning:{enabled:false}` on OpenRouter, `chat_template_kwargs:{enable_thinking:false}` elsewhere
#                    # (Token Factory ignores the OpenRouter field and a thinking run there returns empty content — measured 2026-09-18)
